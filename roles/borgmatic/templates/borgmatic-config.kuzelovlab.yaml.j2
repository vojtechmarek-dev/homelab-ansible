# --- SOURCE & DESTINATION ---
source_directories:
    - /srv
    - /srv_fast
    - /mnt/samba_share

# The repositories option now expects a list of key/value pairs
repositories:
    - path: ssh://borg@{{ remote_tailscale_ip }}/mnt/backup_tank/kuzelovlab
      label: remote

exclude_patterns:
    - '*.pyc'
    - '/srv/**/cache/'
    - '/srv/**/node_modules/'
    - '/srv/immich/library/encoded-video/'
    - '/srv/borgmatic/cache/'

# --- STORAGE & ENCRYPTION ---
encryption_passphrase: "{{ secrets.borgbackup_password }}"
compression: auto,zstd
ssh_command: ssh -o StrictHostKeyChecking=accept-new

checkpoint_interval: 600

# --- ARCHIVE NAMING ---
# Named after the Ansible host rather than borgmatic's default `{hostname}`.
# Inside the container that is the container ID, which changes every time
# compose recreates the container (any change to this role does that).
archive_name_format: '{{ inventory_hostname }}-{now:%Y-%m-%dT%H:%M:%S.%f}'
# Apply retention and checks to every archive in the repository, whatever its
# name. Left unset, borgmatic derives the pattern from archive_name_format, so
# archives written under an earlier name (the container-ID prefix used until
# Nov 2026) would never be pruned. Correct only while this repository has a
# single writer.
match_archives: 'sh:*'

# --- RETENTION POLICY ---
keep_daily: 7
keep_weekly: 4
keep_monthly: 6

# --- HOOKS (Flattened) ---
# We use 'before_backup' directly at the root level.

commands:
    - before: action
      when:
          - create
      run:
          - echo "Starting Database Dumps..."
          - sh -c "docker exec authentik-postgresql-1 pg_dump -U authentik
            authentik > /srv/database_dumps/authentik.sql"
          - sh -c "docker exec mealie-postgres sh -c 'pg_dump -U \$POSTGRES_USER
            \$POSTGRES_DB' > /srv/database_dumps/mealie.sql"
          - sh -c "docker exec seafile-mysql sh -c 'mariadb-dump -u root
            -p\$MYSQL_ROOT_PASSWORD --all-databases' >
            /srv/database_dumps/seafile.sql"

    - after: error
      when:
          - create
          - prune
          - compact
          - check
      run:
          - echo "Backup Failed! Check the logs."

healthchecks:
    ping_url: "{{ secrets.kuzelovlab_borg_healtcheck_url }}"
    states:
        - finish
