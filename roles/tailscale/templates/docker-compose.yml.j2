services:
  tailscaled:
    image: tailscale/tailscale:latest
    container_name: tailscaled
    volumes:
      - {{ state_dir }}:/var/lib/tailscale
    network_mode: host
    cap_add:
      - net_admin
      - net_raw
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      # Store state in a mounted volume
      - TS_STATE_DIR=/var/lib/tailscale
{% if home_lan_subnet %}
      # Expose the subnet to the Tailscale network (subnet router)
      - TS_ROUTES={{ home_lan_subnet }}
{% endif %}
      - TS_USERSPACE=false
      # Preauth key from the vault — used only on first registration / after
      # state is wiped. Once registered, /var/lib/tailscale persists the node
      # identity and the key is ignored. See README "Tailscale preauth key".
      - TS_AUTHKEY={{ secrets.tsauth_key | default('') }}
      # AdGuard owns DNS on the LAN — don't let Tailscale overwrite resolv.conf.
      - TS_EXTRA_ARGS=--accept-dns=false
    restart: unless-stopped
