services:
  postgresql:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    healthcheck:
      interval: 30s
      retries: 5
      start_period: 20s
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      timeout: 5s
    volumes:
      - {{ db_path }}:/var/lib/postgresql/data
    environment:
      POSTGRES_PASSWORD: {{ secrets.authentik_db_password }}
      POSTGRES_USER: authentik
      POSTGRES_DB: authentik
    networks:
      - authentik_internal

  # Default listen address is [::] since 2026.5; it binds dual-stack and still
  # accepts IPv4 on the IPv4-only `proxy` network. If the server ever logs a bind
  # error here, pin AUTHENTIK_LISTEN__HTTP/HTTPS to 0.0.0.0:9000 / 0.0.0.0:9443.
  #
  # Since 2026.8 X-Forwarded-* headers are honoured only from
  # AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS. The default (127/8, 10/8, 172.16/12,
  # 192.168/16) already covers Caddy on the `proxy` bridge, so it is left unset;
  # setting it would *replace* that list, not extend it.
  server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: server
    # Matches upstream compose.yml; Docker's default /dev/shm is only 64 MB.
    shm_size: 512mb
    environment:
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: {{ secrets.authentik_db_password }}
      AUTHENTIK_SECRET_KEY: {{ secrets.authentik_secret_key }}
    volumes:
      # Local file storage root since 2025.12 (uploaded media in /data/media).
      - {{ config_path }}/data:/data
      - {{ config_path }}/custom-templates:/templates
    ports:
      - "9000:9000"
      - "9443:9443"
    depends_on:
      postgresql:
        condition: service_healthy
    networks:
      - authentik_internal
      - proxy # Connect to Caddy

  worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    restart: unless-stopped
    command: worker
    shm_size: 512mb
    environment:
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: {{ secrets.authentik_db_password }}
      AUTHENTIK_SECRET_KEY: {{ secrets.authentik_secret_key }}
    user: root
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ config_path }}/data:/data
      - {{ config_path }}/certs:/certs
      - {{ config_path }}/custom-templates:/templates
    depends_on:
      postgresql:
        condition: service_healthy
    networks:
      - authentik_internal

networks:
  authentik_internal:
  proxy:
    external: true