---
# For configuration options and examples, please see:
# https://gethomepage.dev/configs/docker/
#
# Declares the Docker instance that services reference with `server: local`
# alongside `container: <name>` in services.yaml. Without this file those
# fields are inert — homepage shows no container status at all.
#
# Homepage reaches Docker through the `dockerproxy` service in the compose file
# rather than through the socket, so it can read container state and nothing
# more. `dockerproxy` resolves on the private docker_api network the two share.
#
# Only containers on kuzelovlab are visible here. Services running on medialab
# use `siteMonitor` instead, since this proxy cannot see another host.
local:
  host: dockerproxy
  port: 2375
