---
- Infrastruktura:
    - AdGuard Home:
        icon: adguard-home
        href: http://adguardhome.{{ domain }}
        description: Vlastní DNS a blokování reklam
        server: local
        container: adguard-home
        
    - Caddy:
        icon: caddy
        description: Reverzní Proxy a SSL Certifikáty
        server: local
        container: caddy

    - Cloudflare Tunnel:
        icon: cloudflare.png
        href: https://one.dash.cloudflare.com/
        description: Tunely pro bezpečný přístup z internetu
        server: local
        container: cloudflared
        widget:
            type: cloudflared
            accountid: {{ secrets.cloudflared_accountid }} # from zero trust dashboard url e.g. https://one.dash.cloudflare.com/<accountid>/home/quick-start
            tunnelid: {{ secrets.cloudflared_tunnelid }} # found in tunnels dashboard under the tunnel name
            key: {{ secrets.cloudflared_tunnel_api_key }} # api token with `Account.Cloudflare Tunnel:Read` https://dash.cloudflare.com/profile/api-tokens
    - Authentik:
        icon: authentik
        href: https://auth.{{ domain }}
        description: Naše centrální správa uživatelů a SSO
        server: local
        container: authentik-server-1
        fields: ["users", "loginsLast24H", "failedLoginsLast24H"]
        widget:
            type: authentik
            url: http://server:9000
            key: {{ secrets.authentik_api_key }}
            version: 2
    - Gotify:
        icon: gotify
        href: https://notify.{{ domain }}
        description: Notifikace ze záloh a hlídání místa na disku
        server: local
        container: gotify

    - Borgmatic Healthcheck:
        icon: healthchecks
        description: Borg backup of Kuzelovlab to remote server
        widget:
            type: healthchecks
            url: https://healthchecks.io/
            key: {{ secrets.kuzelovlab_healthcheck_apikey }}
            uuid: {{ secrets.kuzelovlab_borg_healthcheck_uuid }}
- Náš Cloud a Data:
    - Immich:
        icon: immich
        href: https://fotky.{{ domain }}
        description: Zálohování Fotek a Videí (dostupné z internetu)
        server: local
        container: immich_server
        widget:
            type: immich
            url: http://immich-server:2283
            key: {{ secrets.immich_stats_api_key }}
            fields: ["photos", "videos", "storage"]
            version: 2
    - Mealie:
        icon: mealie
        href: https://kucharka.{{ domain }}
        description: Naše Kuchařka (dostupné z internetu)
        server: local
        container: mealie
        widget:
            type: mealie
            url: http://mealie:9000
            key: {{ secrets.mealie_api_key }}
            fields: ["recipes"]
            version: 2
    - Home Assistant:
        icon: home-assistant
        href: https://struhadla.cz
        description: Home assistant (moving soon)
        siteMonitor: https://struhadla.cz

    - Seafile:
        icon: seafile
        href: https://disk.{{ domain }}
        server: local
        container: seafile
        description: Náš vlastní Disk

    - Samba Share:
        icon: samba-server
        href: smb://192.168.0.20/public
        description: Lokální Sdílení Souborů
        server: local
        container: samba

- Náš Zenflix:
    - Jellyfin:
        icon: jellyfin
        href: https://jellyfin.{{ domain }}
        description: Přehrávač Filmů a Seriálů
        siteMonitor: http://192.168.0.30:8096
        widget:
            type: jellyfin
            url: http://192.168.0.30:8096
            key: {{ secrets.jellyfin_api_key }}
            version: 2
            fields: ["movies", "series", "episodes"]
            enableBlocks: true # required for the movies/series/episodes counts
            enableNowPlaying: true # optional, defaults to true
            enableUser: false # optional, defaults to false
            enableMediaControl: false # optional, defaults to true
            showEpisodeNumber: true # optional, defaults to false
            expandOneStreamToTwoRows: false # optional, defaults to true

    - ToChcu!:
        icon: jellyseerr
        href: https://tochcu.{{ domain }}
        description: Žádosti o Filmy a Seriály
        siteMonitor: http://192.168.0.30:5055
        widget:
            type: jellyseerr
            url: http://192.168.0.30:5055
            key: {{ secrets.jellyserr_api_key }}

    - Statistiky Sledování:
        icon: jellystat
        href: https://jellystat.{{ domain }}
        description: Statistiky sledování
        siteMonitor: http://192.168.0.30:8082
        widget:
            type: jellystat
            url: http://192.168.0.30:8082
            key: {{ secrets.jellystat_api_key }}
            days: 30 # optional, defaults to 30
            fields: ["movies", "episodes"]

- Různé:
    - Uptime Kuma:
        icon: uptime-kuma
        href: https://uptime.{{ domain }}
        description: Monitorování dostupnosti služeb
        siteMonitor: http://192.168.0.45:3001
        widget:
            type: uptimekuma
            url: http://192.168.0.45:3001
            slug: servers

    - Stirling PDF:
        icon: stirling-pdf
        href: https://pdf.{{ domain }}
        description: Nástroje pro práci s PDF
        server: local
        container: stirling-pdf

    - Obsidian LiveSync:
        icon: obsidian
        href: https://obsidian.{{ domain }}
        description: Synchronizace poznámek (CouchDB)
        server: local
        container: obsidian-couchdb

- Pirátská zátoka:
    - Radarr:
        icon: radarr
        href: https://radarr.{{ domain }}
        description: Filmy
        siteMonitor: http://192.168.0.30:7878
        widget:
            type: radarr
            url: http://192.168.0.30:7878
            key: {{ secrets.radarr_api_key }}
            enableQueue: true
            fields: ["wanted", "missing", "queued", "movies"]

    - Sonarr:
        icon: sonarr
        href: https://sonarr.{{ domain }}
        description: Seriály
        siteMonitor: http://192.168.0.30:8989
        widget:
            type: sonarr
            url: http://192.168.0.30:8989
            key: {{ secrets.sonarr_api_key }}
            enableQueue: true
            fields: ["wanted", "queued", "series"]

    - Prowlarr:
        icon: prowlarr
        href: https://prowlarr.{{ domain }}
        description: Indexery
        siteMonitor: http://192.168.0.30:9696
        widget:
            type: prowlarr
            url: http://192.168.0.30:9696
            key: {{ secrets.prowlarr_api_key }}

    - Bazarr:
        icon: bazarr
        href: https://bazarr.{{ domain }}
        description: Titulky
        siteMonitor: http://192.168.0.30:6767
        widget:
            type: bazarr
            url: http://192.168.0.30:6767
            key: {{ secrets.bazarr_api_key }}
            fields: ["missingEpisodes", "missingMovies"]

    - qBittorrent:
        icon: qbittorrent
        href: https://torrents.{{ domain }}
        description: Stahování (přes VPN)
        # Port 8080 is published by gluetun, not by the qbittorrent container.
        siteMonitor: http://192.168.0.30:8080
        widget:
            type: qbittorrent
            url: http://192.168.0.30:8080
            username: {{ secrets.qbittorrent_user }}
            password: {{ secrets.qbittorrent_password }}
            fields: ["leech", "download", "seed", "upload"]

    - Tdarr:
        icon: tdarr
        href: https://tdarr.{{ domain }}
        description: Překódování knihovny do H.265
        siteMonitor: http://192.168.0.30:8265
        widget:
            type: tdarr
            url: http://192.168.0.30:8265
            # key omitted: Tdarr runs without auth on the LAN
            fields: ["queue", "processed", "errored", "saved"]

    - Cleanuparr:
        icon: cleanuparr
        href: https://cleanuparr.{{ domain }}
        description: Čištění zaseknutých a neúplných stahování
        # No homepage widget exists for Cleanuparr.
        siteMonitor: http://192.168.0.30:11011
