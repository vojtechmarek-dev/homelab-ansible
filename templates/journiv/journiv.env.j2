# ============================================================================
# REQUIRED SETTINGS
# ============================================================================
SECRET_KEY={{ secrets.journiv_secret_key }}
DOMAIN_NAME=journiv.{{ domain }}
DOMAIN_SCHEME=https

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DB_DRIVER=postgres
POSTGRES_PASSWORD={{ secrets.journiv_db_password }}
POSTGRES_HOST=postgres
POSTGRES_USER=journiv
POSTGRES_DB=journiv_prod
POSTGRES_PORT=5432

# ============================================================================
# REDIS / VALKEY CONFIGURATION
# ============================================================================
REDIS_URL=redis://valkey:6379/0

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_VERSION=latest
ENVIRONMENT=production
APP_PORT={{ app_port }}

# ============================================================================
# OIDC CONFIGURATION (Authentik - Optional but recommended)
# ============================================================================
# Uncomment and fill these in later if you want to use Authentik to log in!
# OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.{{ domain }}/application/o/journiv/
# OIDC_CLIENT_ID={{ secrets.journiv_oauth_client_id | default('') }}
# OIDC_CLIENT_SECRET={{ secrets.journiv_oauth_client_secret | default('') }}
# OIDC_REDIRECT_URI=https://journiv.{{ domain }}/api/v1/auth/oidc/callback
# OIDC_SCOPES="openid email profile"
# OIDC_AUTO_PROVISION=true