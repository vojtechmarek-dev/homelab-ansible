services:
  mealie:
    image: ghcr.io/mealie-recipes/mealie:latest
    container_name: mealie
    ports:
      - "9925:9000"
    deploy:
      resources:
        limits:
          memory: 1000M
    volumes:
      - {{ app_data_path }}:/app/data/
    environment:
      # --- Basic Settings ---
      - ALLOW_SIGNUP=false # Disable open registration, rely on OIDC
      - ALLOW_PASSWORD_LOGIN=false # Disable local password login, rely on OIDC
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
      - BASE_URL=https://kucharka.{{ domain }}
      
      # --- Database Settings ---
      - DB_ENGINE=postgres
      - POSTGRES_USER=mealie
      - POSTGRES_PASSWORD={{ secrets.mealie_db_password }}
      - POSTGRES_SERVER=mealie-db # Matches service name below
      - POSTGRES_PORT=5432
      - POSTGRES_DB=mealie

      # --- OIDC Settings (Authentik) ---
      - OIDC_AUTH_ENABLED=true
      - OIDC_SIGNUP_ENABLED=true # Create users automatically if they login via Authentik
      - OIDC_CONFIGURATION_URL=https://auth.{{ domain }}/application/o/mealie/.well-known/openid-configuration
      - OIDC_CLIENT_ID={{ secrets.mealie_oidc_client_id }}
      - OIDC_CLIENT_SECRET={{ secrets.mealie_oidc_client_secret }}
      - OIDC_NAME=Authentik
      - OIDC_USER_CLAIM=email # Map the email from Authentik to the user in Mealie
      - OIDC_REMEMBER_ME=true
      - OIDC_REQUIRES_EMAIL_VERIFICATION=false

    # --- NETWORK FIX ---
    # Force the container to resolve your auth domain to the Docker Host IP
    # allowing it to reach Caddy -> Authentik internally.
    extra_hosts:
      - "auth.{{ domain }}:host-gateway"

    depends_on:
      mealie-db:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - mealie_internal
      - proxy

  mealie-db:
    image: postgres:17
    container_name: mealie-postgres
    restart: unless-stopped
    volumes:
      - {{ db_path }}:/var/lib/postgresql/data
    environment:
      - POSTGRES_PASSWORD={{ secrets.mealie_db_password }}
      - POSTGRES_USER=mealie
      - POSTGRES_DB=mealie
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mealie"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - mealie_internal

networks:
  mealie_internal:
  proxy:
    external: true