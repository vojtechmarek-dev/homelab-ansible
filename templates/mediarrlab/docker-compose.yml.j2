services:
  # --- 1. VPN Gateway (Gluetun) ---
  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      - 8888:8888/tcp # HTTP Proxy
      - 8080:8080/tcp # qBittorrent Web UI 
      - 6881:6881/tcp # qbittorrent torrent port
      - 6881:6881/udp # qbittorrent torrent port (UDP is important for torrents)
      - 9696:9696/tcp # Prowlarr Web UI 
    environment:
      - VPN_SERVICE_PROVIDER={{ secrets.vpn_service_provider }}
      - VPN_TYPE=wireguard
      - FIREWALL_VPN_INPUT_PORTS={{ secrets.vpn_firewall_vpn_input_ports }}
      - WIREGUARD_PRESHARED_KEY={{ secrets.vpn_wireguard_preshared_key | default('') }}
      - WIREGUARD_PRIVATE_KEY={{ secrets.vpn_wireguard_private_key }}
      - WIREGUARD_PUBLIC_KEY={{ secrets.vpn_wireguard_public_key | default('') }}
      - WIREGUARD_ADDRESSES={{ secrets.vpn_wireguard_addresses }}
      # LAN Network is required so you can access the Web UIs from your laptop
      - FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/24
      - HEALTH_VPN_DURATION_INITIAL=120s
      - TZ=Europe/Prague
      - PUID=1000
      - PGID=1000
    healthcheck:
      test: ping -c 1 www.google.com || exit 1
      interval: 20s
      timeout: 10s
      retries: 5
    restart: unless-stopped

  # --- 2. The Downloader ---
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    network_mode: "service:gluetun" # TRAFFIC GOES THROUGH VPN
    labels:
      - deunhealth.restart.on.unhealthy=true # Enable deunhealth monitoring
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
      - WEBUI_PORT=8080 # must match "qbittorrent web interface" port number in gluetun's service above
      - TORRENTING_PORT={{ secrets.vpn_firewall_vpn_input_ports }}
    volumes:
      - /srv/medialab/config/qbittorrent:/config
      # finished downloads go to media, but active torrents and incomplete downloads stay on the SSD cache for better performance
      - /data/torrents:/data/torrents
      - /mnt/ssd_cache:/data/torrents/incomplete
    deploy:
      resources:
        limits:
          memory: 2g
    depends_on:
      gluetun:
        condition: service_healthy
    restart: unless-stopped

  # 'qBittorrent Stalls with VPN Timeout' - monitor and restart qbittorrent if VPN drops
  deunhealth:
    image: qmcgaw/deunhealth
    container_name: deunhealth
    network_mode: "none"
    environment:
      - LOG_LEVEL=info
      - HEALTH_SERVER_ADDRESS=127.0.0.1:9999
      - TZ=Europe/Prague
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

  # --- 3. The Indexer Manager ---
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    network_mode: "service:gluetun"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /srv/medialab/config/prowlarr:/config
    depends_on:
      gluetun:
        condition: service_healthy
    restart: unless-stopped

  # --- 4. Movie Manager ---
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    ports:
      - 7878:7878
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /srv/medialab/config/radarr:/config
      - /data:/data
    restart: unless-stopped

  # --- 5. TV Show Manager ---
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    ports:
      - 8989:8989
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /srv/medialab/config/sonarr:/config
      - /data:/data
    restart: unless-stopped

  # --- 6. Subtitle Manager ---
  bazaar:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    ports:
      - 6767:6767
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /srv/medialab/config/bazarr:/config
      - /data/media:/data/media
    restart: unless-stopped

  # --- 7. Request Manager (old - migrated to Seerr) ---
  # jellyseerr:
  #   image: fallenbagel/jellyseerr:latest
  #   container_name: jellyseerr
  #   ports:
  #     - 5055:5055
  #   environment:
  #     - PUID=1000
  #     - PGID=1000
  #     - TZ=Europe/Prague
  #   volumes:
  #     - /srv/medialab/config/jellyseerr:/app/config
  #   restart: unless-stopped

  # --- 7. Request Manager (Formerly Jellyseerr) ---
  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    container_name: seerr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /srv/medialab/config/seerr:/app/config
    ports:
      - 5055:5055
    restart: unless-stopped

  # --- 8. Media Server ---
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    ports:
      - 8096:8096
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /srv/medialab/config/jellyfin:/config
      - /data/media:/data/media
    # No devices: this VM only has QEMU's emulated VGA (1234:1111, card0 with no
    # renderD128), so there is no DRM render node and no VAAPI. Transcoding is
    # CPU-only until a real iGPU is passed through (or the stack moves to LXC).
    restart: unless-stopped

  # --- 9. JellyStat DB ---
  jellystat-db:
    image: postgres:15.2
    container_name: jellystat-db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=postgres
      # Use the secret variable here
      - POSTGRES_PASSWORD={{ secrets.jellystat_db_password }}
    volumes:
      - /srv/medialab/config/jellystat/data:/var/lib/postgresql/data

  # --- 10. JellyStat App ---
  jellystat:
    image: cyfershepard/jellystat:latest
    container_name: jellystat
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      # Use the secret variable here
      POSTGRES_PASSWORD: {{ secrets.jellystat_db_password }}
      POSTGRES_IP: jellystat-db
      POSTGRES_PORT: 5432
      # Use the secret variable here
      JWT_SECRET: "{{ secrets.jellystat_jwt_secret }}"
      TZ: Europe/Prague
    volumes:
      - /srv/medialab/config/jellystat/backup-data:/app/backend/backup-data
    ports:
      # Changed to 8082 to avoid conflict with AdGuard (3000) or others
      - "8082:3000"
    depends_on:
      - jellystat-db
  # --- 11. Qbit manage to manage orphaned torrents ---
  qbit_manage:
    image: ghcr.io/stuffanthings/qbit_manage:latest
    container_name: qbit_manage
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
      - QBT_CONFIG=/config/config.yml
      - QBIT_PASS={{ secrets.qbittorrent_password }}
      - QBIT_USER={{ secrets.qbittorrent_user }}
      # Every 30 min. Tdarr stream-copy work can add ~140 GB/h to /data, and
      # nothing is reclaimed until a qbit_manage run tags the stranded torrents
      # noHL and cleans them, so the cadence has to beat the transcode rate.
      # Raise back to 360 once /data has real headroom.
      # Which commands run is decided by the `commands:` block in config.yml,
      # which overrides any QBT_* command flags set here.
      - QBT_SCHEDULE=30

    volumes:
      - /srv/medialab/config/qbit_manage:/config
      - /data/torrents:/data/torrents
      # qBittorrent's .torrent/.fastresume store, read-only. Required by
      # recyclebin.save_torrents so a deleted torrent can be re-added.
      - /srv/medialab/config/qbittorrent/qBittorrent/BT_backup:/torrents:ro
    depends_on:
      gluetun:
        condition: service_healthy
    restart: unless-stopped

  # --- 12.1 Tdarr (Media Transcoding Server) ---
  tdarr:
    image: ghcr.io/haveagitgat/tdarr:latest
    container_name: tdarr
    ports:
      - 8265:8265 # Web UI
      - 8266:8266 # Server port for Nodes
    environment:
      - TZ=Europe/Prague
      - PUID=1000
      - PGID=1000
      - UMASK_SET=002
      - serverIP=0.0.0.0
      - serverPort=8266
      - webUIPort=8265
      # The tdarr-node container below is the only worker, so the server's
      # built-in node stays off (otherwise two nodes fight over the same CPU)
      - internalNode=false
      - inContainer=true
      - ffmpegVersion=7
    volumes:
      - /srv/medialab/config/tdarr/server:/app/server
      - /srv/medialab/config/tdarr/configs:/app/configs
      - /srv/medialab/config/tdarr/logs:/app/logs
      # Map the media directory exactly as Sonarr/Radarr see it
      - /data/media:/data/media
      # Use the fast SSD cache for the heavy transcode writing
      - /mnt/ssd_cache/tdarr:/temp
    restart: unless-stopped

  # --- 12.2 Tdarr Node (The Worker) ---
  tdarr-node:
    image: ghcr.io/haveagitgat/tdarr_node:latest
    container_name: tdarr-node
    environment:
      - TZ=Europe/Prague
      - PUID=1000
      - PGID=1000
      - UMASK_SET=002
      - nodeName=Medialab-CPU-Node
      - serverIP=tdarr
      - serverPort=8266
      - inContainer=true
      - ffmpegVersion=7
      - nodeType=mapped
      # CPU-only node: leave headroom for Jellyfin transcodes on the same VM
      - transcodecpuWorkers=2
      - transcodegpuWorkers=0
      - healthcheckcpuWorkers=1
      - healthcheckgpuWorkers=0
    volumes:
      - /srv/medialab/config/tdarr/configs:/app/configs
      - /srv/medialab/config/tdarr/logs:/app/logs
      - /data/media:/data/media
      - /mnt/ssd_cache/tdarr:/temp
    # CPU-only encodes are slow by nature, so instead of a night-only schedule
    # the node is capped and de-prioritised: it soaks up idle cycles but loses
    # the CPU to Jellyfin/*arr whenever they want it. 4 of 6 cores max.
    cpu_shares: 512
    deploy:
      resources:
        limits:
          cpus: "4.0"
          memory: 4g
    restart: unless-stopped

  # --- 13. Cleanuparr (queue janitor) ---
  # Sonarr/Radarr have no native handling for downloads they refuse to import —
  # padded .exe/.lnk malware from public trackers sits in the queue until
  # someone removes and blocklists it by hand. Cleanuparr does that, then
  # triggers a fresh search so the *arr grabs the next release.
  #
  # Reaches the rest of the stack by service name on the default network:
  # qBittorrent via gluetun:8080 (it shares gluetun's netns), sonarr:8989,
  # radarr:7878. API keys and rules are configured in the web UI at :11011.
  #
  # Leave its orphan/seeding cleanup features OFF — qbit_manage already owns
  # that, and two tools deleting the same data would fight.
  cleanuparr:
    image: ghcr.io/cleanuparr/cleanuparr:latest
    container_name: cleanuparr
    ports:
      - 11011:11011
    environment:
      - PORT=11011
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Prague
    volumes:
      - /srv/medialab/config/cleanuparr:/config
      # Same path as qBittorrent/*arr see it, so Cleanuparr needs no path
      # mapping (leave its Download Directory Source/Target blank). Read-only
      # on purpose: qbit_manage owns all deletion, so a file-touching feature
      # switched on here fails loudly instead of quietly fighting it.
      - /data:/data:ro
    restart: unless-stopped
